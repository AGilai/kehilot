# Server-only environment. Copy to server/.env.local, fill the values locally,
# then export them in the shell running python -m server.app.
# Never use EXPO_PUBLIC_ for credentials; no real credentials belong in Git.
SHUL_SMS_BACKEND=
SHUL_OTP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# To enable the supplied adapter, set SHUL_SMS_BACKEND=twilio and fill all
# TWILIO_* values. Generate a persistent OTP secret locally with:
# .venv/bin/python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep the secret unchanged across server restarts; rotating invalidates codes.
# No production test-code or SMS-bypass mode is provided.
