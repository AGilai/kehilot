# Leave empty to use the clearly labelled, device-local demo.
# For a real phone, use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_COMMUNITY_NAME=הקהילה שלי
# Optional Apple signing team for builds installed on a physical iPhone.
# Simulator builds do not need a signing team.
APPLE_DEVELOPMENT_TEAM=
# Optional local Firebase config for Android push notifications.
GOOGLE_SERVICES_JSON=
# Optional Expo Push Service identifier; not used for compiling the app.
# Leave empty while developing locally without remote push.
EXPO_PUBLIC_EAS_PROJECT_ID=
