{
  "name": "shul-regular",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:device": "expo run:ios --device",
    "android:device": "expo run:android --device",
    "ios:release": "expo run:ios --configuration Release",
    "android:release": "expo run:android --variant release",
    "prebuild": "expo prebuild",
    "check:local": "python3 tools/check_local_build.py",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "export": "expo export --platform all",
    "test:server": ".venv/bin/python -m unittest discover -s server/tests -v",
    "web:dev": "node --env-file=.env.dev node_modules/expo/bin/cli start --web --port 8081",
    "deploy:web": "bash tools/deploy_web.sh --env dev",
    "export:web": "node --env-file=.env.dev node_modules/expo/bin/cli export --platform web --output-dir dist/web",
    "web:fixtures": "EXPO_PUBLIC_FIXTURES=1 expo start --web --port 8081"
  },
  "dependencies": {
    "@expo-google-fonts/heebo": "^0.4.2",
    "@expo-google-fonts/noto-serif-hebrew": "^0.4.2",
    "@hebcal/core": "6.14.2",
    "@hebcal/hdate": "^0.23.1",
    "@hebcal/noaa": "0.12.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "amazon-cognito-identity-js": "6.3.22",
    "expo": "~57.0.31",
    "expo-auth-session": "~57.0.16",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.24",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fflate": "0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
